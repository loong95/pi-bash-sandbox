{
  "name": "pi-bash-sandbox",
  "version": "0.3.0",
  "private": true,
  "description": "MXC-based sandboxed bash/powershell tool for pi: per-project, stateless, config-driven (Windows, Linux, macOS)",
  "license": "MIT",
  "author": "loong",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "mxc",
    "bubblewrap",
    "seatbelt",
    "processcontainer",
    "sandbox",
    "bash",
    "windows",
    "macos"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "all": "pnpm run check && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@microsoft/mxc-sdk": "^1.0.1"
  }
}
