{
  "name": "pi-bash-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "bubblewrap-based sandboxed bash tool for pi: per-project, stateless, config-driven",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "all": "pnpm run check && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.1"
}
