{
  "name": "pi-bash-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "bubblewrap-based sandboxed bash tool for pi: per-project, stateless, config-driven",
  "license": "MIT",
  "author": "loong",
  "keywords": ["pi", "pi-package", "pi-extension", "bubblewrap", "sandbox", "bash"],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "all": "pnpm run check && pnpm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.1"
}
